{
  "manifest_version": 3,
  "name": "Karen",
  "version": "0.1.0",
  "description": "Write and file United and U.S. DOT flight complaints. Fills the forms, you click Submit.",
  "permissions": ["storage", "alarms", "notifications", "scripting", "tabs", "unlimitedStorage"],
  "host_permissions": ["https://www.united.com/*", "https://airconsumer.dot.gov/*", "https://api.anthropic.com/*", "https://api.openai.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Karen" },
  "options_page": "app.html",
  "icons": { "128": "icon.png" }
}
